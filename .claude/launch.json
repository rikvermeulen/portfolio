{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "storybook", "--", "--no-open"],
      "port": 6006,
      "autoPort": false
    },
    {
      "name": "dev-debug",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3007"],
      "port": 3007,
      "autoPort": false
    }
  ]
}
