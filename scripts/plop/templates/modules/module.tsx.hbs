"use client";

import { useGSAP } from "@gsap/react";

import { useRef } from "react";

import { useAnimationContext } from "@/contexts/AnimationContext";

import { createTimelineAnimation } from "./animation";

const {{name}} = ({}: {{name}}Props) => {
  const sectionRef = useRef<HTMLElement>(null);
  const timelineRef = useRef<gsap.core.Timeline | null>(null);
  const { gsap } = useAnimationContext();
  useGSAP(
    () => {
      if (gsap && sectionRef.current) {
        const tl = createTimelineAnimation(gsap, sectionRef.current);
        timelineRef.current = tl;
      }
    },
    { scope: sectionRef, dependencies: [gsap] },
  );

  return (
    <section ref={sectionRef} className="motion-safe:opacity-0">
      {/* Section Content */}
    </section>
  );
};

interface {{name}}Props {}

export default {{name}};
