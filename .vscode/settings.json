{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "search.exclude": {
    "package-lock.json": true
  },
  "git.allowNoVerifyCommit": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.addMissingImports": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "prettier.ignorePath": ".gitignore",
  "prettier.documentSelectors": ["**/*.{cjs,mjs,ts,tsx,md,mdx,json,yaml,yml}"],
  "workbench.colorCustomizations": {
    "activityBar.background": "#042A65",
    "titleBar.activeBackground": "#063B8D",
    "titleBar.activeForeground": "#FBFCFF",
    "titleBar.inactiveBackground": "#113511",
    "titleBar.inactiveForeground": "#F5FCF5"
  }
}
