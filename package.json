{
  "name": "portfolio",
  "version": "0.1.0",
  "description": "Project: Portfolio",
  "contributors": [],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rikvermeulen/portfolio"
  },
  "scripts": {
    "dev": "next dev && NODE_ENV=development",
    "build": "next build && NODE_ENV=production",
    "start": "next start",
    "preview": "next build && next start && NODE_ENV=test",
    "lint": "eslint --fix ./",
    "prepare": "husky install",
    "format": "next lint --fix && prettier --write \"**/*.{ts,tsx,mdx}\" --ignore-path .gitignore",
    "type-check": "tsc --noEmit",
    "check-updates": "ncu -u && npm i"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.9.0",
    "@supabase/supabase-js": "^2.39.3",
    "@t3-oss/env-nextjs": "^0.9.2",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.6.7",
    "contentlayer2": "^0.5.8",
    "encoding": "^0.1.13",
    "framer-motion": "^12.23.22",
    "luxon": "^3.4.4",
    "mapbox-gl": "^3.1.2",
    "next": "15.5.4",
    "next-contentlayer2": "^0.5.8",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^3.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@greenberry/linting-config": "^0.1.84",
    "@prisma/client": "^5.9.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/luxon": "^3.4.2",
    "@types/mapbox-gl": "^2.7.20",
    "@types/node": "20.11.17",
    "@types/prettier": "^2.7.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "clsx": "^2.1.0",
    "eslint": "^9.37.0",
    "husky": "^9.0.10",
    "postcss": "^8.4.35",
    "prisma": "^5.9.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "overrides": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0"
  }
}
