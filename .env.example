NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Planta (optional - server-side only)
# Get your one-time code from https://getplanta.com/apps/manage
PLANTA_AUTH_CODE=""
# Optional: store tokens directly instead of auth code
PLANTA_ACCESS_TOKEN=""
PLANTA_REFRESH_TOKEN=""
PLANTA_TOKEN_TYPE="Bearer"

# Picnic (optional - server-side only)
# Option A: use existing auth key
PICNIC_AUTH_KEY=""
# Option B: login with account credentials
PICNIC_EMAIL=""
PICNIC_PASSWORD=""
PICNIC_COUNTRY_CODE="NL"
# Required to call /api/picnic/auth/key securely
PICNIC_AUTH_ADMIN_SECRET=""

# Plopjs
COMPONENT_LIBRARY_REPO_URL="greenberrynl/unicore/component-library"
COMPONENT_LIBRARY_REPO_TOKEN=""
