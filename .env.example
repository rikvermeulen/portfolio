# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"       # REQUIRED
NEXT_PUBLIC_ENVIRONMENT="development"              # REQUIRED (defaults to "development")
NEXT_PUBLIC_MAPBOX_TOKEN=""                        # optional — FindMe map tile
NEXT_PUBLIC_REACT_SCAN=""                          # optional — "true" enables the react-scan dev overlay

# --- Supabase ---
SUPABASE_URL=""                                    # REQUIRED
SUPABASE_ANON_KEY=""                               # REQUIRED

# --- Spotify---
SPOTIFY_CLIENT_ID=""                               # REQUIRED
SPOTIFY_CLIENT_SECRET=""                           # REQUIRED
SPOTIFY_REFRESH_TOKEN=""                           # optional — mint via `npm run spotify:auth`
SPOTIFY_MARKET="NL"                                # optional — defaults to NL

# --- Steam ---
STEAM_API_KEY=""
STEAM_ID=""

# --- Other gaming profiles (optional; each shows in the drawer only when set) ---
# Xbox: set XBOX_API_KEY (OpenXBL key from https://xbl.io — sign in once with your
# Microsoft account) for REAL Xbox data. Without it, the static link below is used.
XBOX_API_KEY=""                                    # OpenXBL (xbl.io) API key
XBOX_GAMERTAG=""                                   # fallback handle if no API key, e.g. "Parademon117"
XBOX_PROFILE_URL=""                                # fallback link if no API key

# --- Planta ---
PLANTA_AUTH_CODE=""
PLANTA_ACCESS_TOKEN=""
PLANTA_REFRESH_TOKEN=""
PLANTA_TOKEN_TYPE="Bearer"

# --- Picnic ---
# Option A: use an existing auth key (mint via `npm run picnic:auth`)
PICNIC_AUTH_KEY=""
# Option B: log in with account credentials
PICNIC_EMAIL=""
PICNIC_PASSWORD=""
PICNIC_COUNTRY_CODE="NL"
PICNIC_AUTH_ADMIN_SECRET=""

# --- ntfy.sh (outbound push notifications) ---
# All optional. When unset, notification sends are skipped (no error).
# Setup: install the ntfy app, subscribe to a private/unguessable topic, set it here.
NTFY_TOPIC="portfolio"                          # your private topic, e.g. rik-dash-9f3k2 (acts as a secret)
NTFY_SERVER=""                         # optional — self-hosted server; defaults to https://ntfy.sh